[sub_resource type="GDScript" id="GDScript_2jlsd"]
script/source = "extends Node2D

@export var tank: CharacterBody2D
@export var roads: TileMapLayer
@export var road_multiplayer: float = 1.5

var normal_speed: float

func _ready() -> void:
	normal_speed = tank.get(\"speed\")

func _physics_process(_delta: float) -> void:
	
	var tank_position = roads.to_local(tank.global_position)
	
	var cell = roads.local_to_map(tank_position)
	var on_road = roads.get_cell_source_id(cell) != -1
	
	if on_road:
		tank.set(\"speed\", normal_speed * road_multiplayer)
	else:
		tank.set(\"speed\", normal_speed)
"

[node name="DesertLevel1" type="Node2D" unique_id=561814635 node_paths=PackedStringArray("tank", "roads")]
